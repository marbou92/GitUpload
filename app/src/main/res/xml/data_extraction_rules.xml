<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for GitUpload (API 31+).

   The local Room database holds encrypted GitHub PATs. Even though the
   Keystore key never leaves the device, we exclude the database (and its
   -wal / -shm companions) from both cloud backup and device-to-device
   transfer so no token ciphertext ever leaves the originating device.

   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="gitupload_database" />
        <exclude domain="database" path="gitupload_database-wal" />
        <exclude domain="database" path="gitupload_database-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="gitupload_database" />
        <exclude domain="database" path="gitupload_database-wal" />
        <exclude domain="database" path="gitupload_database-shm" />
    </device-transfer>
</data-extraction-rules>
